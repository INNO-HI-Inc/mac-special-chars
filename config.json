{
  "hotkey": { "mods": ["alt"], "key": "space" },
  "palette": {
    "width": 760,
    "height": 660,
    "maxRecent": 10,
    "showShortcutBadge": false,
    "fontScale": 1.0,
    "highContrast": false,
    "wrapArrows": true,
    "rememberScroll": true
  },
  "input": {
    "pasteThreshold": 4,
    "restoreClipboard": true,
    "inputDelay": 0.15
  },
  "privacy": { "excludePersonalFromRecent": true },
  "display": { "followMouse": true, "fade": true }
}
